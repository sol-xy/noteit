# NoteIt Backend Environment Template
# Copy to the repository root as `.env` on your server (never commit `.env`!).
#
# Generate a strong AUTH_TOKEN (at least 24 characters):
#   openssl rand -hex 32

# Required: personal access token shared between your iPhone app, Web UI login, and backend.
AUTH_TOKEN=replace-with-output-of-openssl-rand-hex-32

# Optional: separate secret for signing Web UI session cookies (defaults to HMAC-derived key from AUTH_TOKEN).
# SESSION_SECRET=

# Speech-to-Text & Summarization API keys (stored ONLY on your backend server).
# Get Groq key: https://console.groq.com/keys
GROQ_API_KEY=
# Get Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# AI Model & Pipeline configuration
GROQ_STT_MODEL=whisper-large-v3-turbo
GEMINI_MODEL=gemini-3.5-flash-lite
DEFAULT_STT_PROVIDER=auto

# Delete raw uploaded audio files from disk immediately after transcription succeeds.
DELETE_AUDIO_AFTER_TRANSCRIPTION=true

# Upload & chunking limits
MAX_UPLOAD_MB=200
MAX_AUDIO_SECONDS=14400
CHUNK_DURATION_SECONDS=1200
CHUNK_OVERLAP_SECONDS=5

# Security & storage
# Set COOKIE_SECURE=false only when testing plain HTTP on localhost.
COOKIE_SECURE=true
DATA_DIR=/data
LOG_LEVEL=INFO

# Web Push Notifications (iOS PWA)
# Keys are auto-generated and persisted in /data/vapid_private.pem if VAPID_PRIVATE_KEY is omitted.
PUSH_ENABLED=true
VAPID_SUBJECT=mailto:you@example.com
# VAPID_PRIVATE_KEY=
